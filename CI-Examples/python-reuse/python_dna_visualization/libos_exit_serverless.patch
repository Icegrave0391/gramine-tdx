/* Serverless-aware exit syscall modifications */
/* Add this to libos/src/sys/libos_exit.c */

/* Include the serverless header */
#include "libos_serverless.h"

/* Modified exit_group syscall for serverless mode */
long libos_syscall_exit_group(int error_code) {
    assert(!is_internal(get_cur_thread()));

    error_code &= 0xFF;
    log_debug("---- exit_group (returning %d)", error_code);

    /* Check if we're in serverless mode */
    if (is_serverless_mode_enabled()) {
        serverless_exit_handler(error_code, 0);
        /* This should not return in serverless mode */
        __builtin_unreachable();
    }

    /* Normal exit behavior */
    process_exit(error_code, 0);
}

/* Modified exit syscall for serverless mode */
long libos_syscall_exit(int error_code) {
    assert(!is_internal(get_cur_thread()));

    error_code &= 0xFF;
    log_debug("---- exit (returning %d)", error_code);

    /* Check if we're in serverless mode */
    if (is_serverless_mode_enabled()) {
        /* In serverless mode, treat thread exit as process exit for simplicity */
        serverless_exit_handler(error_code, 0);
        /* This should not return in serverless mode */
        __builtin_unreachable();
    }

    /* Normal exit behavior */
    thread_exit(error_code, 0);
}
